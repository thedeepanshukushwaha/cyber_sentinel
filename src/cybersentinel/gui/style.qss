QWidget {
    background-color: #0D1117;
    color: #C9D1D9;
    font-family: "Inter", "Manrope", "Segoe UI", sans-serif;
}

QMainWindow {
    background-color: #0D1117;
}

#brandLabel {
    font-size: 22px;
    font-weight: 700;
    color: #C9D1D9;
}

#subtitleLabel {
    color: #8B95A4;
    font-size: 12px;
}

#modeToggleButton {
    background-color: #010B10;
    color: #00FF41;
    border: 1px solid #00FF41;
    border-radius: 18px;
    min-width: 160px;
    padding: 10px 18px;
}

#modeToggleButton:checked {
    background-color: #00FF41;
    color: #0D1117;
}

.panelCard {
    background-color: #111921;
    border: 1px solid #1F2937;
    border-radius: 12px;
    padding: 18px;
}

#panelCard QLabel {
    color: #C9D1D9;
}

#sectionTitle {
    font-size: 15px;
    font-weight: 700;
    color: #00FF41;
    margin-bottom: 8px;
}

QLabel {
    color: #C9D1D9;
}

QLineEdit, QComboBox, QPlainTextEdit, QTextEdit, QListWidget {
    background-color: #081018;
    border: 1px solid #1F2937;
    border-radius: 8px;
    color: #C9D1D9;
}

QLineEdit, QComboBox {
    min-height: 36px;
    padding: 6px 10px;
}

QPlainTextEdit#consoleOutput {
    background-color: #020406;
    border: 1px solid #14212B;
    border-radius: 8px;
    color: #C9D1D9;
    font-family: "Fira Code", "JetBrains Mono", "Courier New", monospace;
    font-size: 12px;
}

QPushButton#launchButton {
    background-color: #00FF41;
    color: #0D1117;
    border: none;
    border-radius: 12px;
    font-weight: 700;
    min-height: 44px;
}

QPushButton#launchButton:hover {
    background-color: #8BFF83;
}

QPushButton#stopButton {
    background-color: #FF453A;
    color: #FFFFFF;
    border: none;
    border-radius: 12px;
    font-weight: 700;
    min-height: 44px;
}

QPushButton#stopButton:hover {
    background-color: #FF6A5A;
}

QPushButton#generateButton {
    background-color: #00B37E;
    border: none;
    border-radius: 10px;
    color: #F8FAFC;
    min-height: 38px;
}

QPushButton#reportButton {
    background-color: #010B10;
    border: 1px solid #00FF41;
    border-radius: 10px;
    color: #00FF41;
    min-height: 38px;
}

QPushButton {
    background-color: #0F172A;
    border: 1px solid #1F2937;
    border-radius: 10px;
    color: #C9D1D9;
    padding: 10px 14px;
}

QPushButton:hover {
    background-color: #17243E;
}

QCheckBox {
    color: #C9D1D9;
}

QProgressBar {
    background-color: #0B121D;
    border: 1px solid #1F2937;
    border-radius: 10px;
    color: #C9D1D9;
    min-height: 18px;
}

QProgressBar::chunk {
    background-color: #00FF41;
    border-radius: 10px;
}

#riskScoreLabel {
    font-size: 46px;
    font-weight: 900;
    color: #FF453A;
}

#riskStatusLabel {
    font-size: 14px;
    font-weight: 700;
    color: #FF453A;
}

#riskDetailLabel {
    font-size: 12px;
    color: #7CFC00;
}

#statusLabel {
    color: #C9D1D9;
}

#warningLabel {
    color: #FFB800;
    font-weight: 700;
}

#footerProgress {
    min-width: 240px;
}

#findingsList {
    background-color: #081018;
    border: 1px solid #1F2937;
    border-radius: 8px;
}

#aiAnalysisEditor {
    background-color: #081018;
    border: 1px solid #1F2937;
    border-radius: 10px;
    min-height: 140px;
}

QScrollBar:vertical {
    background: #0D1117;
    width: 10px;
    margin: 0px 0px 0px 0px;
}

QScrollBar::handle:vertical {
    background: #00FF41;
    min-height: 24px;
    border-radius: 5px;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}
