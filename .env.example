# ==============================================================================
# CyberSentinel — Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' and populate your API credentials.
# NEVER commit the actual '.env' file or live API keys to version control.
# ==============================================================================

# OpenRouter Unified API Gateway (Free & Paid models, e.g. Gemini, Llama, DeepSeek)
# Obtain at: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Anthropic Claude API (Recommended for security vulnerability analysis)
# Obtain at: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Google Gemini API
# Obtain at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API (Optional, if using OpenAI endpoints directly)
# Obtain at: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here
